# Copy to .env if you need different ports. All values are optional.
# API server (Express). Default 4100.
INSPECTION_DESK_API_PORT=4100
# Vite development UI. Default 5173. It proxies /api to the API port above.
INSPECTION_DESK_UI_PORT=5173
# Bind address. Keep 127.0.0.1 unless an approved workspace needs another host.
INSPECTION_DESK_HOST=127.0.0.1
# Ports used only by the automated browser checks so they do not collide with a running dev server.
INSPECTION_DESK_TEST_API_PORT=4190
INSPECTION_DESK_TEST_UI_PORT=5190
